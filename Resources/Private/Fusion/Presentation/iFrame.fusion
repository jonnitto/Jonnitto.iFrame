prototype(Jonnitto.iFrame:Component.iFrame) < prototype(Neos.Fusion:Component) {
    height = null
    unit = null
    ratio = null
    src = null
    title = null

    class = null
    showNotificationIfNoSrc = false

    loading = ${Configuration.setting('Jonnitto.iFrame.loading')}
    wrapper = ${Configuration.setting('Jonnitto.iFrame.container')}
    defaultUnit = ${Configuration.setting('Jonnitto.iFrame.defaultUnit')}
    defaultHeight = ${Configuration.setting('Jonnitto.iFrame.defaultHeight')}

    @if.showElement = ${this.src || this.showNotificationIfNoSrc}

    attributes = Neos.Fusion:DataStructure

    @private {
        class = ${Carbon.String.classNames('jonnitto-iframe', props.class, Type.isString(props.wrapper) ? props.wrapper : null)}
        heightUnit = ${props.unit || props.defaultUnit}
        style = Neos.Fusion:DataStructure {
            @process.toString = ${Carbon.String.styles(value)}
            position = 'relative'
            background = 'transparent'
            border = 'none'
            width = '100%'
            aspectRatio = ${props.ratio}
            aspectRatio.@if.ratio = ${props.ratio}
            height = ${props.height ? (props.height + private.heightUnit) : (props.defaultHeight[private.heightUnit])}
            height.@if.noRatio = ${!props.ratio}
        }
    }

     renderer = afx`
        <Carbon.Eel:Tag
            tagName={props.wrapper ? 'div' : null}
            attributes.class={private.class}
        >
            <iframe
                @if.set={props.src}
                title={props.title}
                loading={props.loading}
                allowtransparency="true"
                style={private.style}
                src={props.src}
                {...props.attributes}
                class={Carbon.String.classNames(props.wrapper ? null : private.class, props.attributes.class)}
            >
            </iframe>
            <Carbon.Notification:Tag
                @if.set={props.showNotificationIfNoSrc && !props.src}
                type='alert'
                content={Translation.translate('noSrc', 'Please add a internal or external URL in the inspector', [], 'NodeTypes/iFrame', 'Jonnitto.iFrame')}
            />
        </Carbon.Eel:Tag>
    `
}
